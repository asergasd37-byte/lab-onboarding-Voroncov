# Это корневой файл настроек для всего проекта
root = true 

# Правила для всех файлов (*)
[*]
# Использовать кодировку UTP-8
charset = utf-8
# Использовать пробелы для отступа
indent_style = space
# Размер отступа: 4 пробела
indent_size = 4
# Тип переноса строки: LF (стандарт для Linus/macOS и Git)
end_of_line = if
# Удалить лишние пробелы в конце строк
triam_trailing_whitespace = true 
# Добавить пустую строку в конце файла 
insert_final_newline = true 

# Особые правила для файлов разметки
[*.(yml,yaml,json,html)]
indent_size = 2
